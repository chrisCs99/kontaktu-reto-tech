# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Reglas sin barra inicial a propósito: el repo tiene varios proyectos
# hermanos (web/, voice-agent/), cada uno con su propio node_modules, build,
# etc. Una regla anclada a la raíz (ej. "/node_modules") solo cubriría la
# raíz del repo, no la de cada subproyecto.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
